{
  "entities": {
    "Vegetable": {
      "title": "Vegetable",
      "description": "A vegetable item for sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "isSeasonal": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price", "unit", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "customer": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "mobile": { "type": "string" },
            "address": { "type": "string" },
            "pincode": { "type": "string" }
          }
        },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "paymentMethod": { "type": "string" }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized admin user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      }
    }
  },
  "firestore": {
    "vegetables/{vegetableId}": {
      "schema": "Vegetable",
      "description": "Product catalog"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "List of administrators"
    }
  }
}
